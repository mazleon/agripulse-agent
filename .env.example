# ─── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Weather ──────────────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=

# ─── Notifications ────────────────────────────────────────────────────────────
# Firebase service account JSON (single-line stringified)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Bangladesh SMS — SSL Wireless
SSL_WIRELESS_API_KEY=
SSL_WIRELESS_SENDER_ID=AgriPulse

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agripulse:agripulse@localhost:5432/agripulse
DATABASE_URL_SYNC=postgresql://agripulse:agripulse@localhost:5432/agripulse

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=7200

# ─── Graphiti (Neo4j backend) ─────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agripulse_dev

# ─── Embeddings ───────────────────────────────────────────────────────────────
# Used by LlamaIndex for RAG (fastembed = free local, or openai)
EMBEDDING_PROVIDER=fastembed
# OPENAI_API_KEY=sk-...   # only needed if EMBEDDING_PROVIDER=openai

# ─── Observability ────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agripulse
SENTRY_DSN=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO

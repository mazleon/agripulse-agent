# ─── LLM Provider ────────────────────────────────────────────────────────────
# Supported: anthropic | openai | google | openrouter
LLM_PROVIDER=openrouter

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ─── Weather ──────────────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=

# ─── Notifications ────────────────────────────────────────────────────────────
# Firebase service account JSON (single-line stringified)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Bangladesh SMS — SSL Wireless
SSL_WIRELESS_API_KEY=
SSL_WIRELESS_SENDER_ID=AgriPulse

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase (Cloud PostgreSQL with pgvector) — primary for production
# Get your project URL and service role key from https://supabase.com/dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-supabase-db-password
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL_SYNC=postgresql://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:5432/postgres

# Local fallback (development)
# DATABASE_URL=postgresql+asyncpg://agripulse:agripulse@localhost:5432/agripulse
# DATABASE_URL_SYNC=postgresql://agripulse:agripulse@localhost:5432/agripulse

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=7200

# ─── Graphiti (Neo4j backend) ─────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agripulse_dev

# ─── Qdrant (vector store for RAG) ───────────────────────────────────────────
# Local dev: leave QDRANT_URL=http://localhost:6333 and QDRANT_API_KEY empty
# Cloud (prod): get cluster URL + API key from https://cloud.qdrant.io/
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agripulse_rag

# ─── Embeddings ───────────────────────────────────────────────────────────────
# Used for RAG (fastembed = free local, or openai)
EMBEDDING_PROVIDER=fastembed
# OPENAI_API_KEY=sk-...   # only needed if EMBEDDING_PROVIDER=openai

# ─── Observability ────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agripulse
SENTRY_DSN=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO
